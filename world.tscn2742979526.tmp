[sub_resource type="GDScript" id="GDScript_wse8f"]
script/source = "extends CharacterBody3D

const SPEED = 3.8 # Скорость Деда

@onready var nav_agent: NavigationAgent3D = $NavigationAgent3D
@onready var player: CharacterBody3D = $\"../Player\" # Ищем Джосика на карте

# Ссылка на аниматор, встроенный в твою модель Sketchfab
@onready var anim_player: AnimationPlayer = $Sketchfab_Scene/AnimationPlayer

func _ready() -> void:
	# Проверяем, есть ли у автора анимация бега
	if anim_player.has_animation(\"run\"):
		anim_player.play(\"run\")
	elif anim_player.get_animation_list().size() > 0:
		# Если названия \"run\" нет, запускаем первую доступную анимацию из списка модели
		anim_player.play(anim_player.get_animation_list()[0])

func _physics_process(_delta: float) -> void:
	# Каждую секунду передаем Деду текущие координаты Джосика
	nav_agent.target_position = player.global_transform.origin
	
	# Если цель еще не достигнута — бежим к ней
	if not nav_agent.is_navigation_finished():
		var next_pos = nav_agent.get_next_path_position()
		var direction = (next_pos - global_transform.origin).normalized()
		
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
		
		# Дед будет автоматически поворачиваться лицом к Джосику во время погони
		look_at(Vector3(player.global_position.x, global_position.y, player.global_position.z), Vector3.UP)
		
		move_and_slide()
"

